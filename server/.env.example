# Copy this file to `.env` before starting the server:
#
#   cp .env.example .env
#
# `.env` is gitignored so real secrets never reach GitHub. These defaults match
# the PostgreSQL container in docker-compose.yml, so they work as-is locally.

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with any PostgreSQL
# already installed on the usual 5432.
DATABASE_URL="postgresql://ngo:ngolocal@localhost:5433/ngocommons?schema=public"

# --- Server -------------------------------------------------------------
PORT=5001

# Signing key for login tokens. At least 16 characters.
# The server refuses to start in production if this is left unset.
JWT_SECRET="local-dev-secret-change-this-before-you-deploy-anywhere"

# Browser origins allowed to call the API. Loopback and private-network
# addresses are accepted automatically outside production, so the app works
# when opened from another device on the same Wi-Fi.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Uploads ------------------------------------------------------------
# Identity documents and photos are written here, outside the web root. Files
# are only ever served through an authenticated, permission-checked endpoint.
UPLOAD_DIR="./private-uploads"
MAX_UPLOAD_MB=5

# --- Email (optional) ---------------------------------------------------
# Used for password-reset links. Without a key the link is printed to the
# server console instead, so the reset flow still works for a demo.
# Free tier: https://resend.com
# RESEND_API_KEY=""
# MAIL_FROM="NGO Impact Commons <onboarding@resend.dev>"

# Base URL used to build password-reset links.
APP_URL="http://localhost:5173"
